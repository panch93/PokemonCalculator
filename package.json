{
  "name": "pokemon-team-lab",
  "version": "1.0.4",
  "private": true,
  "description": "Pok\u00e9mon team matchup analysis with Showdown team import/export and format-aware legality validation.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:move-data": "node scripts/check-move-data.mjs",
    "check:field-effects": "node scripts/check-field-effects.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:release": "npm run typecheck && npm test && npm run check:move-data && npm run check:field-effects && npm run build"
  },
  "dependencies": {
    "@pkmn/dex": "0.10.11",
    "@pkmn/sim": "0.10.11",
    "@smogon/calc": "0.12.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.8.3",
    "vitest": "^5.0.5"
  }
}

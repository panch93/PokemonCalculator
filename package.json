{
  "name": "pokemon-team-lab",
  "version": "2.4.3",
  "private": true,
  "description": "Pok\u00e9mon team matchup analysis with Showdown team import/export and format-aware legality validation.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:move-data": "node scripts/check-move-data.mjs",
    "check:field-effects": "node scripts/check-field-effects.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:champions": "RUN_CHAMPIONS_CALC_TESTS=1 vitest run tests/calc.test.ts",
    "check:release": "npm run typecheck && npm test && npm run check:no-pkmn-dex && npm run check:no-pkmn-sim && npm run check:move-data && npm run check:field-effects && npm run build",
    "check:no-pkmn-dex": "node scripts/check-no-pkmn-dex.mjs",
    "test:format-contract": "vitest run tests/format-validation.contract.test.ts",
    "test:format-provider": "vitest run tests/format-validation-provider.test.ts tests/format-validation.contract.test.ts tests/format-validation.test.ts",
    "check:no-pkmn-sim": "node scripts/check-no-pkmn-sim.mjs"
  },
  "dependencies": {
    "@smogon/calc": "0.12.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.8.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "sharp": {
      "detect-libc": "2.1.2"
    }
  }
}
